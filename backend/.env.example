# ── App ───────────────────────────────────────────────────────────────────
APP_NAME=Sarwagya
APP_ENV=development          # development | production
SECRET_KEY=change-this-to-a-long-random-string-min-32-chars
ALLOWED_ORIGINS=http://localhost:3000,https://sarwagya.vercel.app

# ── Supabase (free at supabase.com) ───────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here
DATABASE_URL=postgresql+asyncpg://postgres:password@db.xxxx.supabase.co:5432/postgres

# ── Neo4j AuraDB (free at neo4j.com/aura) ────────────────────────────────
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-aura-password

# ── Upstash Redis (free at upstash.com) ──────────────────────────────────
UPSTASH_REDIS_URL=rediss://default:password@xxxxx.upstash.io:6379
# For local dev docker redis:
REDIS_URL=redis://localhost:6379

# ── Qdrant (free local or qdrant.io free cloud) ───────────────────────────
QDRANT_URL=http://localhost:6333
# QDRANT_URL=https://xxxx.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=                # leave blank for local

# ── LLMs (all free tiers) ─────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_key_here           # groq.com - free
GEMINI_API_KEY=AIzaSy_your_gemini_key_here    # aistudio.google.com - free
OLLAMA_BASE_URL=http://localhost:11434         # local ollama - free

# ── Data Sources (all free) ───────────────────────────────────────────────
# UN Comtrade - register free at comtradeplus.un.org
COMTRADE_KEY=your-comtrade-key

# World Bank - no key needed (public API)
WORLD_BANK_API=https://api.worldbank.org/v2

# GDELT - no key needed (public)
GDELT_API=https://api.gdeltproject.org/api/v2

# NewsAPI - free tier at newsapi.org (1000 req/day)
NEWS_API_KEY=your-newsapi-key

# UCDP - Uppsala Conflict Data Program (free academic registration via email)
UCDP_TOKEN=your-ucdp-token
UCDP_VERSION=23.1

# Wikidata SPARQL - no key needed (public)
WIKIDATA_SPARQL=https://query.wikidata.org/sparql

# REST Countries - no key (public)
REST_COUNTRIES_API=https://restcountries.com/v3.1

# ── Monitoring (free) ─────────────────────────────────────────────────────
SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx   # sentry.io free

# ── Rate limits ───────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_DAY=1000
